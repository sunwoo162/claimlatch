CLAIMLATCH_LLM_API_KEY=
CLAIMLATCH_LLM_MODEL=
# CLAIMLATCH_LLM_BASE_URL=https://api.openai.com/v1
TAVILY_API_KEY=

# Reverse proxy (optional)
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=https://api.openai.com/v1
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=
# OpenLLM uses an explicit local server URL and optionally a configured API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=openllm
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:3000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=na
# TensorRT-LLM trtllm-serve uses an explicit local server URL and optional API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=tensorrtllm
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:8000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=tensorrt_llm
# Aphrodite Engine uses an explicit local server URL and optional API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=aphrodite
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:2242
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=sk-empty
# KoboldCpp uses an explicit local server URL and optional API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=koboldcpp
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:5001
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=koboldcpp-local
# LMDeploy uses an explicit local server URL and optional API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=lmdeploy
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:23333
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=lmdeploy-local
# Xinference uses an explicit local server URL and optional API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=xinference
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:9997
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=xinference-local
# text-generation-webui uses an explicit local server URL and optional API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=textgen
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:5000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=textgen-local
# CLAIMLATCH_PROXY_HOST=127.0.0.1
# CLAIMLATCH_PROXY_PORT=4317
# CLAIMLATCH_REQUIRE_DOCUMENT_PROVENANCE=1
