# Reference configuration for examples/provider-compatible-proxy.ts.
# Replace every `replace-me` value before running the example.
# This file is documentation only; the example does not load .env files automatically.

# OpenAI-compatible providers (ai21, aimlapi, baichuan, baseten, cerebrium, chutes, clarifai, cloudflare, groq, jan, litellm, llamacpp, lmstudio, localai, mistral, modal, moonshot, nebius, nscale, novita, ollama, poe, requesty, cohere, dashscope,
# deepinfra, deepseek, featherless, fastchat, fireworks, friendli, gemini, inferencenet, ionos, lamini, minimax, mimo, mlx, sglang, tgi, together, tokenhub, vllm, volcengine, xai, perplexity,
# sambanova, scaleway, siliconflow, stepfun, upstage, nvidia, cerebras, huggingface, hyperbolic, hunyuan, qianfan, zai, ovhcloud, or openai)
CLAIMLATCH_PROXY_PROVIDER_PROFILE=groq
CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# ClaimLatch verifier and evidence provider
CLAIMLATCH_LLM_API_KEY=replace-me
CLAIMLATCH_LLM_MODEL=replace-me
TAVILY_API_KEY=replace-me

# Azure-style deployment profile requires an explicit provider base URL.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=azure
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=https://your-resource.openai.azure.com
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# Modal Endpoints require an explicit endpoint URL and use a bearer proxy token.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=modal
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=https://your-modal-endpoint.example
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# Cerebrium deployment endpoints require an explicit function URL and use a bearer JWT.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=cerebrium
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=https://api.cortex.cerebrium.ai/v4/your-project/your-app/run
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# Nscale uses the hosted inference endpoint and bearer authentication.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=nscale
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# LiteLLM uses a self-hosted gateway URL and bearer authentication.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=litellm
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:4000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# Ollama uses an explicit local or cloud base URL. Local Ollama ignores the compatibility API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=ollama
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:11434
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=ollama

# llama.cpp uses an explicit server URL and optionally a configured API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=llamacpp
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:8080
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# vLLM uses an explicit server URL and optionally a configured API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=vllm
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:8000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# LM Studio uses an explicit local server URL and optionally a configured API token.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=lmstudio
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:1234
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=lm-studio

# Jan uses an explicit local server URL and optionally a configured API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=jan
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://127.0.0.1:1337
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=secret-key-123

# LocalAI uses an explicit local server URL and optionally a configured API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=localai
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:8080
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=sk-localai

# SGLang uses an explicit server URL and optionally a configured API key.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=sglang
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:30000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=sglang-local

# TGI uses an explicit server URL and optionally a configured API key.
# Its model-list route is disabled unless explicitly configured.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=tgi
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:3000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=-
# CLAIMLATCH_PROXY_UPSTREAM_MODELS_PATH=/models

# MLX-LM uses an explicit local server URL. It does not provide built-in API-key authentication.
# Set the API key only when an external authentication layer consumes the proxy's Bearer header.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=mlx
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://127.0.0.1:8080
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=mlx-local

# FastChat uses an explicit server URL and accepts EMPTY by default or a configured API key.
# Its undocumented model-retrieval route is disabled unless explicitly overridden.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=fastchat
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=http://localhost:8000
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=EMPTY
# CLAIMLATCH_PROXY_UPSTREAM_MODEL_RETRIEVAL_PATH=/v1/models

# OpenRouter additionally requires attribution metadata.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=openrouter
# CLAIMLATCH_PROXY_OPENROUTER_SITE_URL=https://your-app.example
# CLAIMLATCH_PROXY_OPENROUTER_APP_NAME=Your App
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# Cloudflare Workers AI requires an account-scoped base URL and has no default model-list route.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=cloudflare
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/ai/v1
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me
# CLAIMLATCH_PROXY_UPSTREAM_MODELS_PATH=/models

# Clarifai uses Authorization: Key for PAT authentication and has no documented OpenAI model-list route.
# CLAIMLATCH_PROXY_PROVIDER_PROFILE=clarifai
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY=replace-me

# A custom provider can override the profile defaults.
# CLAIMLATCH_PROXY_UPSTREAM_BASE_URL=https://provider.example
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY_HEADER=x-api-key
# CLAIMLATCH_PROXY_UPSTREAM_API_KEY_PREFIX=Api-Key
# CLAIMLATCH_PROXY_UPSTREAM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# CLAIMLATCH_PROXY_UPSTREAM_MODELS_PATH=/v1/models

# Optional provider routing and observability settings.
# CLAIMLATCH_PROXY_UPSTREAM_REQUEST_HEADERS=x-provider-tenant=prod,x-provider-version=2026-09
# CLAIMLATCH_PROXY_UPSTREAM_RESPONSE_HEADER_NAMES=x-vendor-request-id
# CLAIMLATCH_PROXY_UPSTREAM_RESPONSE_HEADER_PREFIXES=x-vendor-rate-
# CLAIMLATCH_PROXY_UPSTREAM_TIMEOUT_MS=120000
